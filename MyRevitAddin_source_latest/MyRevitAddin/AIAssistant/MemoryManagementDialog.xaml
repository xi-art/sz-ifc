<Window x:Class="MyRevitAddin.AIAssistant.MemoryManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧠 AI 记忆链管理" Height="680" Width="860"
        WindowStartupLocation="CenterOwner" Background="White"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部说明 -->
        <Border Grid.Row="0" Background="#E3F2FD" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontWeight="Bold" Foreground="#1565C0" FontSize="14"
                           Text="🧠 AI 记忆链沉淀系统"/>
                <TextBlock FontSize="11" Foreground="#555" Margin="0,3,0,0"
                           TextWrapping="Wrap">
                    让 AI 逐步本土化适应你工作方式。左边记录工作流、中间导入规则/资料+自动扫描本地命令档案、右边总览/搜索/删除/备份。
                    所有保存的内容都会注入到后续对话的「系统提示词」里，AI 会优先参考。
                </TextBlock>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" x:Name="Tabs">
            <!-- ===== Tab 1：💾 记录工作流 ===== -->
            <TabItem Header="💾 记录工作流">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="工作流标题：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" x:Name="TxtWorkflowTitle"
                                 FontSize="13" Padding="6,4"
                                 Text="例：批量给所有建筑项目样板添加消防专业过滤器"
                                 Foreground="#888"
                                 GotFocus="TxtWorkflowTitle_GotFocus"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="2.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="项目/上下文：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" x:Name="TxtWorkflowContext" FontSize="12" Padding="6,4"
                                 Text="例：XX大厦项目 建筑专业 v3.2 样板"/>
                        <TextBlock Grid.Column="2" Text="（可选）" VerticalAlignment="Center" Foreground="#888"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="操作步骤（每行一条，或用 1. 2. 3.）："
                                   FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Grid.Row="1" x:Name="TxtWorkflowSteps"
                                 FontFamily="Consolas" FontSize="12" Padding="6,6"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="经验教训 / 注意事项（可选）："
                                   FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Grid.Row="1" x:Name="TxtWorkflowLessons"
                                 FontSize="12" Padding="6,4"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 MaxHeight="80" VerticalScrollBarVisibility="Auto"/>
                    </Grid>

                    <Border Grid.Row="4" Padding="8" Background="#F5F5F5" CornerRadius="3">
                        <Button x:Name="BtnSaveWorkflow"
                                Content="💾 保存工作流（将写入记忆，AI 以后会参考）"
                                Background="#2E7D32" Foreground="White" FontWeight="Bold"
                                Padding="16,7" HorizontalAlignment="Center"
                                Click="BtnSaveWorkflow_Click"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== Tab 2：📚 导入规则/资料 + 自动导入 C# 命令档案 ===== -->
            <TabItem Header="📚 导入规则 / 资料">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 快捷：自动扫描 C# 命令档案 -->
                    <GroupBox Grid.Row="0" Header="🤖 一键自动扫描（强烈推荐）" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="12" Foreground="#555" TextWrapping="Wrap">
                                    扫描项目中的 *Command.cs 源代码文件，提取 XML summary 注释，变成"命令档案"写入记忆。
                                    这样 AI 就能知道本地有哪些现成的 Revit 命令功能可用，回答时优先推荐。
                                </TextBlock>
                                <TextBlock x:Name="TxtAutoScanStatus" FontSize="11" Margin="0,4,0,0"
                                           Foreground="#1565C0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🔎 扫描并预览" Padding="14,5" Margin="0,0,6,0"
                                        Background="#FFF8E1" BorderBrush="#FBC02D"
                                        Click="BtnScanPreview_Click"/>
                                <Button x:Name="BtnScanImport" Content="✅ 导入到记忆" Padding="14,5"
                                        Background="#1565C0" Foreground="White" FontWeight="SemiBold"
                                        IsEnabled="False"
                                        Click="BtnScanImport_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- 手动录入 -->
                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="规则分类：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="1" x:Name="CmbRuleCategory" FontSize="12" IsEditable="True">
                            <ComboBoxItem Content="命名规则" IsSelected="True"/>
                            <ComboBoxItem Content="出图/制图标准"/>
                            <ComboBoxItem Content="公司规范"/>
                            <ComboBoxItem Content="项目专属要求"/>
                            <ComboBoxItem Content="协作流程"/>
                            <ComboBoxItem Content="构件参数规则"/>
                            <ComboBoxItem Content="其他（外部资料）"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Text="规则标题：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="3" x:Name="TxtRuleTitle" FontSize="12" Padding="6,4"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="资料来源：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" x:Name="TxtRuleSource" FontSize="12" Padding="6,4" Text="人工录入"/>
                        <TextBlock Grid.Column="2" Text="（可选）" VerticalAlignment="Center" Foreground="#888"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="规则 / 资料详细内容（支持粘贴大段文本、TXT/MD 内容）："
                                   FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Grid.Row="1" x:Name="TxtRuleContent"
                                 FontFamily="Consolas" FontSize="12" Padding="6,6"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>

                    <Border Grid.Row="4" Padding="8" Background="#F5F5F5" CornerRadius="3">
                        <Button x:Name="BtnSaveRule"
                                Content="📚 保存到业务规则记忆（AI 回答时必须遵守）"
                                Background="#0277BD" Foreground="White" FontWeight="Bold"
                                Padding="16,7" HorizontalAlignment="Center"
                                Click="BtnSaveRule_Click"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== Tab 3：📖 记忆总览 + 搜索 + 删除 + 导入导出 ===== -->
            <TabItem Header="📖 记忆总览 / 搜索 / 备份">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索 + 过滤 -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔎 关键词搜索：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearch" FontSize="13" Padding="6,4"
                                 TextChanged="TxtSearch_TextChanged"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <TextBlock Text="类型过滤：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="CmbTypeFilter" Width="160" FontSize="12"
                                      SelectionChanged="CmbTypeFilter_SelectionChanged">
                                <ComboBoxItem Content="（全部，共 6 类）" Tag="ALL" IsSelected="True"/>
                                <ComboBoxItem Content="对话记录" Tag="Conversation"/>
                                <ComboBoxItem Content="工具操作" Tag="Operation"/>
                                <ComboBoxItem Content="用户偏好" Tag="UserPreference"/>
                                <ComboBoxItem Content="💾 工作流" Tag="Workflow"/>
                                <ComboBoxItem Content="📚 业务规则" Tag="KnowledgeRule"/>
                                <ComboBoxItem Content="🤖 命令档案" Tag="CmdArchive"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- 操作按钮行 -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TxtSummary" FontSize="12" VerticalAlignment="Center"
                                   Foreground="#1565C0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="📋 刷新" Padding="12,4" Margin="0,0,6,0" Click="BtnRefresh_Click"/>
                            <Button Content="💿 导出 JSONL" Padding="12,4" Margin="0,0,6,0" Click="BtnExport_Click"/>
                            <Button Content="⬆ 导入 JSONL" Padding="12,4" Margin="0,0,6,0" Click="BtnImport_Click"/>
                            <Button x:Name="BtnDelete" Content="🗑 删除选中" Padding="12,4"
                                    Background="#C62828" Foreground="White" FontWeight="SemiBold"
                                    Click="BtnDelete_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 列表 -->
                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>
                        <ListView Grid.Column="0" x:Name="LstEntries"
                                  SelectionChanged="LstEntries_SelectionChanged"
                                  BorderBrush="#CCC" BorderThickness="1" FontSize="11">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="时间" Width="130"
                                                    DisplayMemberBinding="{Binding Time}"/>
                                    <GridViewColumn Header="类型" Width="90"
                                                    DisplayMemberBinding="{Binding Type}"/>
                                    <GridViewColumn Header="摘要" Width="280"
                                                    DisplayMemberBinding="{Binding Summary}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <GroupBox Grid.Column="1" Header="详细内容" Margin="8,0,0,0" Padding="6">
                            <RichTextBox x:Name="RtbDetail"
                                         IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="12"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="6"/>
                        </GroupBox>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="TxtMemLocation" FontSize="11" Foreground="#888"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部 -->
        <Border Grid.Row="2" Background="#F0F4F8" Padding="10,8" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <Button Content="关闭" HorizontalAlignment="Right" Padding="20,6" Click="BtnClose_Click"/>
        </Border>
    </Grid>
</Window>
